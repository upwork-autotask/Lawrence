# Leave DATABASE_URL unset for local dev/test — the app uses embedded PGlite.
# For production, point at a real Postgres:
# DATABASE_URL=postgres://user:pass@host:5432/hr_web

# Required in all environments. Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-change-me-in-production-please-0001

# Where uploaded files are stored in dev (local-disk adapter).
UPLOAD_DIR=./uploads

# Optional SMTP for notifications (Phase 5). Unset = notifications no-op.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
